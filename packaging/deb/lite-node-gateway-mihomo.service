[Unit]
Description=Lite Node Gateway Mihomo Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lite-node-gateway
Group=lite-node-gateway
Environment=GATEWAY_DATA_DIR=/var/lib/lite-node-gateway
Environment=MIHOMO_CONFIG_FILE=/var/lib/lite-node-gateway/config.yaml
Environment=MIHOMO_MIXED_PORT=7896
Environment=MIHOMO_EXTERNAL_CONTROLLER=127.0.0.1:9090
ExecStart=/opt/lite-node-gateway/bin/lite-node-gateway-mihomo.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
