[Unit]
Description=Lite Node Gateway Manager
After=network-online.target lite-node-gateway-mihomo.service
Wants=network-online.target lite-node-gateway-mihomo.service

[Service]
Type=simple
User=lite-node-gateway
Group=lite-node-gateway
WorkingDirectory=/opt/lite-node-gateway/manager
Environment=GATEWAY_DATA_DIR=/var/lib/lite-node-gateway
Environment=MIHOMO_API_URL=http://127.0.0.1:9090
Environment=MIHOMO_CONFIG_IN_CORE=/var/lib/lite-node-gateway/config.yaml
Environment=MIHOMO_MIXED_PORT=7896
Environment=MIHOMO_EXTERNAL_CONTROLLER=127.0.0.1:9090
Environment=SYSTEM_PROXY_HELPER_URL=http://127.0.0.1:18089
Environment=SYSTEM_PROXY_SERVER=127.0.0.1:7896
Environment=SYSTEM_PROXY_TEST_PROXY=http://127.0.0.1:7896
Environment=PORT_PROBE_PROXY_HOST=127.0.0.1
Environment=MANAGER_HOST=127.0.0.1
Environment=MANAGER_PORT=8089
ExecStart=/usr/bin/python3 /opt/lite-node-gateway/manager/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
